{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "outDir": ".verify",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "exclude": [
    "src/lib/stats.ts"
  ],
  "include": [
    "scripts/verify-export.ts",
    "scripts/verify-markji.ts",
    "scripts/verify-stats.ts",
    "src/lib/**/*.ts",
    "src/db/sqlite.ts",
    "scripts/push-one.ts",
    "scripts/backfill-lemma.ts"
  ]
}