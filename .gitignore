# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data: user db (private) + dictionary (regenerable, ~150MB)
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/dict/

# vercel
.vercel

# verification build output
/.verify/

# typescript
*.tsbuildinfo
next-env.d.ts

# strays
nohup.out

# local service logs
/logs/

# db backups
/data/*.bak*

# unit test build output
/.unit/

# 离线解析验证的临时 CommonJS 编译产物
/.tmp-import/

# 插件打包产物
/dist/

# IDE 剪贴板截图缓存（无版本管理价值，且是二进制大文件）
/.qoder-input-images/

# 图片代理的运行时缓存（可重新抓取，无版本管理价值）
/data/img-cache/
