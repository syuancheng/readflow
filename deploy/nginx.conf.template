# ReadFlow 反向代理（server-setup.sh 把 __SERVER_NAME__ 换成你的域名，没有域名时为 _ = 任意）
# 安装位置：/etc/nginx/conf.d/readflow.conf
# 配 HTTPS：备案通过、域名解析到服务器后运行 certbot --nginx -d 你的域名（见 deploy/README.md）
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # 导入 txt / md 文件
    client_max_body_size 20m;

    # 构建产物带内容哈希，可以长期缓存
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 365d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 直接覆盖成真实访客 IP，不沿用客户端传来的 X-Forwarded-For：
        # 登录限速按它的第一段计数，若用 $proxy_add_x_forwarded_for，客户端伪造一个值就能绕过
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        # 经 HTTPS 访问时登录 cookie 会自动带上 Secure
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI 释义 / 分段小结是流式输出：关掉缓冲，字才能一个个出来
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
