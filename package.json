{
  "name": "inkwell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "import:ecdict": "node scripts/import-ecdict.mjs",
    "verify:cards": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-export.js",
    "verify:markji": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-markji.js",
    "push:one": "tsc -p tsconfig.verify.json && node .verify/scripts/push-one.js",
    "backfill:lemma": "tsc -p tsconfig.verify.json && node .verify/scripts/backfill-lemma.js",
    "verify:stats": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-stats.js",
    "bench": "node scripts/bench-reader.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^30.1.3",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
