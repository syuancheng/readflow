{
  "name": "readflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.unit.json && node --test .unit/tests/unit/*.test.js",
    "test:e2e": "node scripts/e2e-readlang.mjs",
    "test:extension": "node scripts/e2e-extension.mjs",
    "import:ecdict": "node scripts/import-ecdict.mjs",
    "verify:cards": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-export.js",
    "verify:markji": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-markji.js",
    "push:one": "tsc -p tsconfig.verify.json && node .verify/scripts/push-one.js",
    "backfill:lemma": "tsc -p tsconfig.verify.json && node .verify/scripts/backfill-lemma.js",
    "backfill:cefr": "tsc -p tsconfig.verify.json && node .verify/scripts/backfill-cefr.js",
    "verify:stats": "tsc -p tsconfig.verify.json && node .verify/scripts/verify-stats.js",
    "bench": "node scripts/bench-reader.mjs",
    "test:settings": "node scripts/smoke-settings.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "service:install": "bash scripts/service.sh install",
    "service:status": "bash scripts/service.sh status",
    "service:restart": "bash scripts/service.sh restart",
    "service:logs": "bash scripts/service.sh logs",
    "service:uninstall": "bash scripts/service.sh uninstall"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^30.1.3",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
