# DeepSeek API Key —— 用于「AI 深度释义 / 追问」这一层。
# 不配置也能跑：词典层照常工作，AI 层返回提示文案。
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 可选：覆盖用户数据库路径，默认 data/lexreader.db
# DB_PATH=./data/lexreader.db

# 墨墨开放 API 令牌 —— 用于「导出到墨墨记忆卡」。
# 不配置也能跑：导出页会提示未配置，其余功能不受影响。
# 获取：墨墨 App → 我的 → 更多设置 → 实验功能 → 开放 API
#      或 https://open.maimemo.com/open/api/v1/tokens/openapi
# 注意：这个令牌可以往你的牌组里写卡片（不可逆），不要提交到仓库。
MARKJI_TOKEN=
